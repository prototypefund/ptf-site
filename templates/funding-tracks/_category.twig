{% extends "_layouts/layout.twig" %}

{% set projectsQuery = craft.entries.section("projects").relatedTo(category) %}

{% paginate projectsQuery.limit(28) as pagination, projects %}

{% do craft.blitz.options.paginate(pagination.totalPages) %}

{% block content %}
  {% include "_modules/headers/simple.twig" with {
    headline: category.headline|default(category.title),
    intro: category.intro,
    secondaryText: category.secondaryText,
    link: category.genericLink,
    background: category.headerBackground.value,
    alignment: category.headerAlignment.value
  } only %}

  <div class="mt-10">
    {% if projects|length %}
      {% embed "_modules/next-reads.twig"
        with {
          heading: "All Projects"|t,
          count: projectsQuery.count()
        }
      %}
        {% block content %}
          {% include "projects/_modules/teasers-list.twig" with {
            projects: projects
          } %}
        {% endblock %}
      {% endembed %}

      {% include "_modules/pagination.twig" with {
        pagination
      } %}
    {% endif %}

    {% include "_modules/modules.twig" with {
      entry: category
    } %}
  </div>
{% endblock %}
