{% set context = context|default("web") %}

{% set web %}
  {% set content %}
    {% include "_rich-text/standard" with {
      text: entry.text
    } only %}
  {% endset %}

  {% include "_modules/side-heading" with {
    headline: entry.title,
    content: content,
    fullWidth: entry.fullWidth
  } only %}
{% endset %}

{% set rss %}
  {% if entry.title|length %}
    <h2>{{ entry.title }}</h2>
  {% endif %}
  {% include "_rich-text/standard" with {
    text: entry.text
  } only %}
{% endset %}

{% switch context %}
  {% case "rss" %}
    {{ rss }}
  {% default %}
    {{ web }}
{% endswitch %}
