{% set filterConfig =
  [
    {
      title: "Funding status"|t,
      param: "status",
      items: [
        {
          title: "Currently funded projects"|t,
          slug: "inFunding"
        },
        {
          title: "Second Stage funding phase"|t,
          slug: "secondStage"
        }
      ]
    },
    {
      title: "Funding cycle"|t,
      param: "funding-cycle",
      items: craft.categories.group("projectYearGroups").eagerly().all()|merge(
        craft.categories.group("projectRounds").eagerly().all()
      )
    },
    {
      title: "Funding Track"|t,
      param: "funding-track",
      items: craft.categories.group("projectFundingTracks").eagerly().all()
    },
    {
      title: "Topics"|t,
      param: "topic",
      items: craft.categories.group("projectTopics").eagerly().all()
    },
    {
      title: "Technologies"|t,
      param: "technology",
      items: craft.categories.group("projectTechnologies").eagerly().all()
    },
    {
      title: "Licenses"|t,
      param: "license",
      items: craft.categories.group("projectLicenses").eagerly().all()
    }
  ]|filter(group => (group.items|length) > 1)
%}

{% set filters = [] %}

{% for group in filterConfig %}
  {% set activeSlugs =
    craft.customQueryStringParser.getQueryParam(group.param)
  %}

  {% set filters =
    filters|merge(
      [
        {
          title: group.title,
          param: group.param,
          items: group.items
            |map(
              item => {
                id: "filter-#{group.param}-#{item.slug}",
                title: item.title,
                value: item.slug,
                isActive: item.slug in activeSlugs
              }
            )
            |values
        }
      ]
    )
  %}
{% endfor %}

{% set activeItems =
  filters
    |filter(group => group.items|filter(item => item.isActive))
    |map(group => group.items|filter(item => item.isActive))
    |reduce((carry, items) => carry|merge(items), [])
%}

<project-filters class="ml-auto md:ml-0">
  <div data-filters>
    <button
      type="button"
      data-filter-toggle
      class="absolute top-[5px] right-0 flex cursor-pointer items-center gap-[10px] md:hidden"
    >
      <span class="sr-only">Toggle filter</span>
      <span class="font-surt text-ui-12 tracking-wider uppercase">Filter</span>
      <svg
        class="{{
        activeItems|length
          ? "fill-gray-900 dark:fill-white"
          : "fill-none"
        }}"
        width="18"
        height="18"
        viewBox="0 0 18 18"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          class="stroke-gray-900 dark:stroke-white"
          d="M3.375 5.875V4C3.375 3.65482 3.65482 3.375 4 3.375H14.0001C14.3452 3.375 14.625 3.65479 14.6251 3.99994L14.6253 5.875M3.375 5.875L7.53175 9.43794C7.67028 9.55669 7.75001 9.73 7.75001 9.91244V13.8245C7.75001 14.2311 8.13214 14.5295 8.52658 14.4309L9.77658 14.1184C10.0548 14.0488 10.25 13.7988 10.25 13.512V9.9125C10.25 9.73 10.3297 9.55669 10.4683 9.43794L14.6253 5.875M3.375 5.875H14.6253"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </button>

    {% if activeItems|length %}
      <div class="my-3 flex flex-wrap gap-x-1 gap-y-3 md:hidden">
        <ul class="flex flex-wrap gap-1">
          {% for item in activeItems %}
            <li>
              <button
                type="button"
                data-filter-remove="{{ item.id }}"
                aria-label="{{ "Remove filter: {title}"|t(
                  params: {
                    title: item.title
                  }
                ) }}"
                class="text-body-16 block cursor-pointer rounded-[2px] border border-gray-900 bg-gray-900 px-1 py-0.5 text-white dark:bg-gray-100 dark:text-gray-900"
              >
                {{ item.title }}
              </button>
            </li>
          {% endfor %}
        </ul>

        {% include "projects/_modules/reset-filters" only %}
      </div>
    {% endif %}

    <form
      method="get"
      action="{{ url(craft.app.request.pathInfo) }}#list"
      data-filter-form
      class="group/form z-3 hidden overflow-auto px-2 pt-5 md:block md:overflow-visible md:px-0 md:pt-0 [.filter-open_&]:fixed [.filter-open_&]:top-0 [.filter-open_&]:left-0 [.filter-open_&]:block [.filter-open_&]:h-[100dvh] [.filter-open_&]:w-full [.filter-open_&]:bg-white [.filter-open_&]:md:static [.filter-open_&]:md:h-auto [.filter-open_&]:dark:bg-gray-900"
    >
      <div class="relative">
        <h2 class="font-surt text-head-24 mb-5">{{ "Filter projects"|t }}</h2>
        <button
          type="button"
          data-filter-close
          class="bg-close dark:bg-close-white absolute top-0 right-0 h-4 w-4 cursor-pointer bg-center bg-no-repeat md:hidden"
        >
          <span class="sr-only">Close filter</span>
        </button>
      </div>

      {% for item in filters %}
        <div
          class="border-gray mb-4 border-t pt-[10px] last:mb-0 dark:border-gray-500"
        >
          <fieldset>
            <legend
              class="md:text-body-16 dark:text-gray mb-2 text-[15px] text-gray-600 uppercase"
            >
              {{ item.title }}
            </legend>

            {% switch item.param %}
              {% case "status" %}
                {% include "_modules/filter-checkboxes.twig" with {
                  name: item.param,
                  filters: item.items
                } only %}
              {% default %}
                {% include "_modules/filter-input-buttons.twig" with {
                  name: item.param,
                  filters: item.items,
                  size: "large"
                } only %}
            {% endswitch %}
          </fieldset>
        </div>
      {% endfor %}

      <div
        class="border-gray sticky bottom-0 mt-6 border-t bg-white py-4 md:py-0 md:group-data-enhanced/form:hidden dark:border-gray-500 dark:bg-gray-900"
      >
        <button type="submit" class="group cursor-pointer">
          {% include "_modules/button.twig" with {
            text: "Apply filters"|t
          } only %}
        </button>
      </div>
    </form>
  </div>
</project-filters>
