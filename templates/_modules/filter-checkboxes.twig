{% set name = name ?? null %}
{% set filters = filters|default([]) %}

<ul class="space-y-1">
  {% for filter in filters %}
    <li>
      <input
        type="checkbox"
        id="{{ filter.id }}"
        name="{{ name }}"
        value="{{ filter.value }}"
        class="peer sr-only"
        {{ filter.isActive ? "checked" }}
      />
      <label
        for="{{ filter.id }}"
        class="text-head-16 peer-checked:before:bg-tick-white dark:peer-checked:before:bg-tick-black peer-focus-visible:ring-highlighting-yellow flex cursor-pointer items-start gap-[10px] peer-focus-visible:ring-8 before:block before:min-h-[18px] before:min-w-[18px] before:rounded-[2px] before:bg-center before:bg-no-repeat before:content-[''] peer-checked:before:bg-black dark:peer-checked:before:bg-white [:not(:checked)+&]:before:bg-gray-300 dark:[:not(:checked)+&]:before:bg-gray-700"
      >
        {{ filter.title }}
      </label>
    </li>
  {% endfor %}
</ul>
