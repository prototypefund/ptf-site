{% set color = color|default("pink") %}

{% set colors = {
  pink: "bg-pink dark:bg-dark-magenta dark:text-white",
  gray: "bg-gray-200 dark:text-gray-900"
} %}

<div
  class="{{
  colors[color]
  }} text-ui-10 md:text-ui-11 inline-block rounded-sm px-0.75 py-[3px] text-gray-900 uppercase"
>
  {{ text }}
</div>
