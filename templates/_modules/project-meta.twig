{# @var \craft\elements\Entry entry #}
{% set categories =
  entry.projectYearGroups.eagerly().all()
    |merge(entry.projectRounds.eagerly().all())
    |merge(entry.projectFundingTracks.eagerly().all())
    |merge(entry.projectTopics.eagerly().all())
    |merge(entry.projectTechnologies.eagerly().all())
%}
{% set class = class ?? "" %}
{% set link = link ?? false %}

{% if (categories|length) or entry.isInFunding %}
  <ul
    class="md:text-body-12 *:after:text-gray dark:text-gray-[#BDBDBD] flex flex-wrap items-baseline justify-start gap-y-0.5 text-[10px] tracking-[0.015em] text-gray-400 uppercase *:after:px-1 *:after:content-['|'] *:last:after:hidden md:*:after:px-1.25 dark:*:after:text-gray-500 {{
    class
    }}"
  >
    {% if entry.isInFunding %}
      <li>
        {% include "_modules/pill.twig" with {
          color: "pink",
          text: "In Funding"|t
        } %}
      </li>
    {% endif %}
    {% for category in categories %}
      {% if link %}
        <li>
          <a
            href="{{ category.url }}"
            class="hover:text-gray-600 dark:hover:text-gray-300"
          >
            {{ category.title }}
          </a>
        </li>
      {% else %}
        <li>{{ category.title }}</li>
      {% endif %}
    {% endfor %}
  </ul>
{% endif %}
