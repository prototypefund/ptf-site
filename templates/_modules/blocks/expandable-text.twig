{% set context = context|default("web") %}
{% set expandableItems = module.expandableItems %}

{% set web %}
  {% set content %}
    {% include "_modules/blocks/expandable-text-items.twig" with {
      expandableItems: expandableItems
    } only %}
  {% endset %}

  {% include "_modules/side-heading" with {
    headline: module.title,
    content: content
  } only %}
{% endset %}

{% set rss %}
  <h2>{{ module.title }}</h2>
  {% for item in expandableItems %}
    <h3>{{ item.headline|default(item.title) }}</h3>
    {% if item.type == "timeline" %}
      {% include "_modules/timeline" with {
        phases: item.phases,
        text: item.text
      } only %}
    {% else %}
      {% include "_rich-text/standard" with {
        text: item.text
      } only %}
    {% endif %}
  {% endfor %}
{% endset %}

{% switch context %}
  {% case "rss" %}
    {{ rss }}
  {% default %}
    {{ web }}
{% endswitch %}
