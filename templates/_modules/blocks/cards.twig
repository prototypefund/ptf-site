{% set context = context|default("web") %}
{% set heading = module.title %}
{% set cards = module.cards.eagerly().all() %}
{% set showStepNumbers = module.showStepNumbers ?? true %}

{% set web %}
  <div class="mb-10 px-2 md:px-5">
    <h4 class="font-surt text-head-22 md:text-head-32 mb-3 md:mb-5">
      {{ heading }}
    </h4>

    {% if cards|length %}
      <div
        class="border-gray border-y md:flex md:border-x dark:border-gray-500"
      >
        {% for card in cards %}
          <div
            class="border-gray flex flex-col items-start gap-4 border-r border-b border-l px-2 py-3 last:border-b-0 md:w-1/3 md:border-b-0 md:border-l-0 md:px-2.5 md:py-4 md:last:border-r-0 dark:border-gray-500"
          >
            <div class="space-y-0.5">
              {% if showStepNumbers %}
                <p
                  class="font-surt {{
                  card.title is empty
                    ? "text-head-24 md:text-head-28"
                    : "text-head-22 md:text-head-24"
                  }} text-rich-blue dark:text-sky-blue"
                >
                  0{{ loop.index }}
                </p>
              {% endif %}
              {% if card.title is not empty %}
                <h5 class="text-head-22 md:text-head-28">{{ card.title }}</h5>
              {% endif %}
            </div>

            <div class="mt-auto pt-4">
              {% include "_rich-text/simple" with {
                text: card.cardText,
                size: "large"
              } only %}
            </div>

            {% if card.genericLink %}
              {% include "_modules/button-generic-link.twig" with {
                link: card.genericLink
              } only %}
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
{% endset %}

{% set rss %}
  <h2>{{ module.title }}</h2>
  {% for card in cards %}
    <h3>0{{ loop.index }}</h3>
    {% include "_rich-text/simple" with {
      text: card.cardText,
      size: "large"
    } only %}
  {% endfor %}
{% endset %}

{% switch context %}
  {% case "rss" %}
    {{ rss }}
  {% default %}
    {{ web }}
{% endswitch %}
